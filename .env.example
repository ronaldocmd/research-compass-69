# Copy to .env and adjust locally: cp .env.example .env
# Never commit real credentials.

# PostgreSQL (used by the postgres service and to build DATABASE_URL)
POSTGRES_USER=rda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rda
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://rda:change-me@postgres:5432/rda
BACKEND_CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# OpenAlex search provider (RDA-012)
# No API key required. Email is optional and only used by OpenAlex to grant
# a higher rate limit ("polite pool"); never put credentials here.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_EMAIL=

# Frontend
FRONTEND_PORT=3000
# Browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side (container network) API URL
API_INTERNAL_URL=http://backend:8000

# Research API base URL used by the frontend (RDA-007)
# NEXT_PUBLIC_API_URL -> used by the browser
# API_INTERNAL_URL    -> used by Next.js server components/actions inside the Docker network
