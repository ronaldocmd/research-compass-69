# Backend environment template (RDA-053).
# Copy to backend/.env and adjust locally. Never commit real credentials.
# The backend reads this file from its own working directory (backend/.env).

# Application
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL (must match the postgres service in docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rda:change-me@localhost:5432/rda

# OpenAlex search provider (RDA-012). No API key required; an email is
# optional and only used by OpenAlex to grant a higher rate limit
# ("polite pool"); never put credentials here.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_EMAIL=
OPENALEX_TIMEOUT_SECONDS=10.0

# Crossref search provider (RDA-013). No API key required; an email is
# optional and only used by Crossref to grant a higher rate limit
# ("polite pool"); never put credentials here.
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_EMAIL=
CROSSREF_TIMEOUT_SECONDS=10.0

# Multi-source search (RDA-066). Providers are queried in parallel; CORE is
# skipped without a key, Unpaywall enrichment is off without an e-mail.
SEARCH_PROVIDERS=openalex,crossref,semantic_scholar,arxiv,europe_pmc,core
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=10.0
ARXIV_BASE_URL=https://export.arxiv.org
ARXIV_TIMEOUT_SECONDS=15.0
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EUROPE_PMC_TIMEOUT_SECONDS=10.0
CORE_BASE_URL=https://api.core.ac.uk/v3
CORE_API_KEY=
CORE_TIMEOUT_SECONDS=10.0
UNPAYWALL_BASE_URL=https://api.unpaywall.org/v2
UNPAYWALL_EMAIL=
UNPAYWALL_TIMEOUT_SECONDS=8.0

# Document downloader (RDA-018)
DOWNLOAD_TIMEOUT_SECONDS=30.0
DOWNLOAD_MAX_SIZE_BYTES=52428800
DOWNLOAD_ALLOWED_CONTENT_TYPES=application/pdf,text/html,application/octet-stream

# File storage (RDA-019)
STORAGE_BASE_DIR=storage/documents

# Embeddings (RDA-023). OPENAI_API_KEY is required only when the embedding
# or LLM providers are used. Read it from the environment; never hardcode it.
# EMBEDDING_BASE_URL points the OpenAI-compatible client at a local backend
# (e.g. Ollama's /v1 endpoint) instead of api.openai.com; leave unset to use
# a real OpenAI key. Deliberately not OPENAI_BASE_URL (RDA-067): that name
# is easy to already have set ambiently in a shell/host environment for
# unrelated tooling, which would otherwise silently redirect embeddings
# there instead, with the relevance filter then failing closed (no
# filtering, not an error) rather than raising.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# Retrieval (RDA-024)
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.7

# LLM (RDA-025)
LLM_MODEL=gpt-4o-mini

# Planning (RDA-030)
PLANNING_MIN_TASKS=3
PLANNING_MAX_TASKS=10
